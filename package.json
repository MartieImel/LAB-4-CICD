{
  "name": "github-actions-vercel-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch scripts/server.js",
    "start": "node scripts/server.js",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/unit/*.test.js",
    "test:perf": "node tests/perf/load-test.js",
    "build": "node scripts/build.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.12.0"
  }
}
